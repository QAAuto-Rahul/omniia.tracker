# Required: random string, 32+ chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# SMTP used to email login codes. Leave SMTP_HOST empty in development and
# codes are printed to the server console instead. Required in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false   # true for port 465 (inferred automatically)
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Omniia Tracker <no-reply@sdlccorp.com>"
Mongo_DB=mongodb+srv://rahulp_db_user:<db_password>@superapp.mlgwhat.mongodb.net/?appName=Superapp
# MongoDB connection
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?appName=Superapp
MONGODB_DB=omniia_tracker

# Required: 32-byte base64 key that encrypts env values at rest. Back it up!
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENV_ENCRYPTION_KEY=

# Shared secret for the Netlify scheduled health check (netlify/functions/health-cron.mts)
CRON_SECRET=
